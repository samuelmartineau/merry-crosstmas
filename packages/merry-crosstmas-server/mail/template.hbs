<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,address=no,email=no,date=no">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Your Secret Santa match</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<style>
  html,body{margin:0!important;padding:0!important;width:100%!important;}
  body{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
  table,td{border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;}
  img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}
  .message img{max-width:100%!important;height:auto!important;}
  .message p{margin:0 0 12px;}
  a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}
  @media screen and (max-width:620px){
    .px{padding-left:22px!important;padding-right:22px!important;}
    .name{font-size:32px!important;line-height:38px!important;}
    .outer{padding:0!important;}
    .card{border-radius:0!important;}
  }
  
</style>
</head>
<body style="margin:0;padding:0;background-color:#f4ede4;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">Ho ho ho {{fromName}}! Open to find out who you are gifting this year 🎁&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4ede4;">
<tr><td align="center" class="outer" style="padding:32px 12px;">
<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border-radius:16px;overflow:hidden;">
  <!-- candy-cane stripe -->
  <tr><td height="10" style="height:10px;font-size:0;line-height:0;background-color:#c8102e;background-image:repeating-linear-gradient(-45deg,#c8102e 0 12px,#ffffff 12px 24px);">&nbsp;</td></tr>
  <!-- compact header -->
  <tr><td align="center" bgcolor="#c8102e" style="background-color:#c8102e;padding:22px 24px 20px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="font-size:34px;line-height:40px;padding-right:12px;">🎅</td>
      <td style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:36px;font-weight:bold;color:#ffffff;letter-spacing:1px;">Secret Santa</td>
      <td style="font-size:34px;line-height:40px;padding-left:12px;">🎄</td>
    </tr></table>
    <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;letter-spacing:3px;text-transform:uppercase;color:#ffd7dc;padding-top:4px;">Merry Crosstmas</div>
  </td></tr>
  <!-- reveal -->
  <tr><td align="center" class="px" style="padding:32px 48px 8px;">
    <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;letter-spacing:2px;text-transform:uppercase;color:#8a7a6a;">Your secret friend is</div>
    <div class="name" style="font-family:Georgia,'Times New Roman',serif;font-size:40px;line-height:48px;font-weight:bold;color:#1e6b3a;padding-top:6px;">{{toName}}</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;"><tr>
      <td width="40" style="border-top:2px solid #e7d8c4;font-size:0;line-height:0;">&nbsp;</td>
      <td style="padding:0 10px;font-size:14px;line-height:14px;color:#c8102e;">&#10052;</td>
      <td width="40" style="border-top:2px solid #e7d8c4;font-size:0;line-height:0;">&nbsp;</td>
    </tr></table>
  </td></tr>
  <!-- custom message -->
  <tr><td class="px message" style="padding:20px 48px 36px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#3d3a36;">
    {{{content}}}
  </td></tr>
  <!-- footer -->
  <tr><td align="center" style="background-color:#fbf6ef;border-top:1px solid #f0e6d8;padding:26px 24px 28px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td align="center" bgcolor="#1e6b3a" style="border-radius:999px;background-color:#1e6b3a;">
        <a href="https://santa.samuelmartineau.com" style="display:inline-block;padding:12px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:999px;">🎁&nbsp; Organize your own Secret Santa</a>
      </td></tr></table>
    <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#9b8c7c;padding-top:16px;">Sent with love by <a href="https://santa.samuelmartineau.com" style="color:#9b8c7c;">Merry Crosstmas</a> · made by <a href="https://samuelmartineau.com/" style="color:#9b8c7c;">Samuel Martineau</a></div>
  </td></tr>
  <tr><td height="10" style="height:10px;font-size:0;line-height:0;background-color:#c8102e;background-image:repeating-linear-gradient(-45deg,#c8102e 0 12px,#ffffff 12px 24px);">&nbsp;</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table>
</body></html>
